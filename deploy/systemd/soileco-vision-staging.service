[Unit]
Description=SoilEco Camera Vision staging dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/soileco-camera/staging
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/soileco-camera/staging/src:/opt/soileco-camera/staging/deploy
ExecStart=/opt/soileco-camera/staging/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8081 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
